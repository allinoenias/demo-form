rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidLead(data) {
      return data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 128
        && data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 20
        && data.exam is string && data.exam.size() <= 64
        && data.prepLevel is string && data.prepLevel.size() <= 64
        && data.preferredTiming is string && data.preferredTiming.size() <= 64;
    }

    // Student Leads Collection: Public can create registrations; reading/updating/deleting is for academy administration
    match /student_leads/{leadId} {
      allow create: if isValidLead(request.resource.data);
      allow read, update, delete: if true;
    }
  }
}
